<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B132B"/>
      <stop offset="100%" stop-color="#1C2541"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00B4D8"/>
      <stop offset="50%" stop-color="#06D6A0"/>
      <stop offset="100%" stop-color="#10B981"/>
    </linearGradient>
    <linearGradient id="shieldStroke" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Background rounded box -->
  <rect width="500" height="500" rx="100" fill="url(#bgGrad)"/>

  <!-- Subtle glow ring -->
  <circle cx="250" cy="205" r="140" fill="none" stroke="url(#shieldStroke)" stroke-width="2" opacity="0.3" stroke-dasharray="8 12"/>

  <!-- Outer Shield Badge -->
  <path d="M250 85 L345 125 V215 C345 290 250 330 250 330 C250 330 155 290 155 215 V125 Z" 
        fill="none" stroke="url(#shieldStroke)" stroke-width="8" stroke-linejoin="round" filter="url(#glow)"/>

  <!-- Left Modern Tower -->
  <rect x="200" y="175" width="34" height="90" rx="4" fill="url(#accentGrad)"/>
  <rect x="208" y="190" width="7" height="8" rx="1" fill="#0B132B"/>
  <rect x="220" y="190" width="7" height="8" rx="1" fill="#0B132B"/>
  <rect x="208" y="210" width="7" height="8" rx="1" fill="#0B132B"/>
  <rect x="220" y="210" width="7" height="8" rx="1" fill="#0B132B"/>
  <rect x="208" y="230" width="7" height="8" rx="1" fill="#0B132B"/>
  <rect x="220" y="230" width="7" height="8" rx="1" fill="#0B132B"/>

  <!-- Right Modern Tower (Taller) -->
  <rect x="242" y="145" width="46" height="120" rx="4" fill="#FFFFFF"/>
  <rect x="250" y="160" width="10" height="10" rx="2" fill="#0B132B"/>
  <rect x="268" y="160" width="10" height="10" rx="2" fill="#0B132B"/>
  <rect x="250" y="180" width="10" height="10" rx="2" fill="#0B132B"/>
  <rect x="268" y="180" width="10" height="10" rx="2" fill="#0B132B"/>
  <rect x="250" y="200" width="10" height="10" rx="2" fill="#0B132B"/>
  <rect x="268" y="200" width="10" height="10" rx="2" fill="#0B132B"/>
  <rect x="250" y="220" width="10" height="10" rx="2" fill="#0B132B"/>
  <rect x="268" y="220" width="10" height="10" rx="2" fill="#0B132B"/>

  <!-- Smart Security Gate Barrier Line -->
  <path d="M175 275 H325" stroke="url(#accentGrad)" stroke-width="7" stroke-linecap="round"/>
  <circle cx="250" cy="275" r="9" fill="url(#accentGrad)" filter="url(#glow)"/>

  <!-- Branding Text -->
  <text x="250" y="405" font-family="'Segoe UI', Poppins, -apple-system, sans-serif" font-size="44" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="6">GATENEST</text>
  <text x="250" y="442" font-family="'Segoe UI', Poppins, -apple-system, sans-serif" font-size="15" font-weight="700" fill="#38BDF8" text-anchor="middle" letter-spacing="4">SMART VISITOR ACCESS</text>
</svg>